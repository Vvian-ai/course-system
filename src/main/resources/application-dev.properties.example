# 本地开发配置模板
# 使用方法：复制本文件为 application-dev.properties，再填入你自己的值
# application-dev.properties 已在 .gitignore 中，不会被提交

# ===== 数据库 =====
spring.datasource.username=root
spring.datasource.password=你的数据库密码

# ===== 管理员账号 =====
# 注意：这里的密码是 BCrypt 哈希，不是明文
# 生成方式见 README 的「如何生成 BCrypt 哈希」一节
app.admin.username=admin
app.admin.password=$2a$10$请替换成你自己生成的BCrypt哈希

# ===== JWT 密钥 =====
# 至少 32 个字符。生产环境请通过环境变量 JWT_SECRET 覆盖
app.jwt.secret=请替换成你自己的随机密钥至少32个字符
